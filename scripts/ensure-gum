#!/usr/bin/env bash
# Source this file — do not execute directly.
# Ensures gum is available in the scripts directory, exposing it as $GUM.

_scripts_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export GUM="$_scripts_dir/gum"

if [ -x "$GUM" ]; then return 0; fi

os="" arch="" version=""

case "$(uname -s)" in
    Darwin) os="Darwin" ;;
    Linux)  os="Linux"  ;;
    *) echo "Unsupported OS: $(uname -s)" >&2; return 1 ;;
esac

case "$(uname -m)" in
    x86_64)          arch="x86_64" ;;
    aarch64 | arm64) arch="arm64"  ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; return 1 ;;
esac

version=$(curl -fsSL https://api.github.com/repos/charmbracelet/gum/releases/latest \
    | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')

echo "Installing gum v${version} → ${_scripts_dir}..."
_tmpdir=$(mktemp -d)
curl -fsSL "https://github.com/charmbracelet/gum/releases/download/v${version}/gum_${version}_${os}_${arch}.tar.gz" \
    | tar -xz -C "$_tmpdir"
find "$_tmpdir" -name "gum" -type f -exec mv {} "$GUM" \;
chmod +x "$GUM"
rm -rf "$_tmpdir"
