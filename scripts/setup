#!/usr/bin/env bash
set -euo pipefail

# ── ensure gum ───────────────────────────────────────────────────────────────

# shellcheck source=ensure-gum
source "$(dirname "${BASH_SOURCE[0]}")/ensure-gum"

# ── check uv ─────────────────────────────────────────────────────────────────

if ! command -v uv &>/dev/null; then
    gum style \
        --foreground 196 --bold \
        "uv not found. Install it from https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
fi

# ── header ────────────────────────────────────────────────────────────────────

gum style \
    --border rounded \
    --border-foreground 99 \
    --padding "1 4" \
    --margin "1 0" \
    "$(gum style --foreground 99 --bold 'Transformer') — Project Setup"

# ── mode selection ────────────────────────────────────────────────────────────

CHOICE=$(gum choose \
    --header "Select setup mode:" \
    --header.foreground 245 \
    --cursor.foreground 99 \
    --item.foreground 255 \
    --selected.foreground 99 \
    --selected.bold \
    "run   — core only         (train, infer, use the model)" \
    "dev   — core + dev tools  (jupyter, ruff, ty, ipython)" \
    "test  — core + test suite (pytest, coverage, benchmarks)" \
    "all   — everything        (core + dev + test)")

# ── resolve args ──────────────────────────────────────────────────────────────

case "${CHOICE%% *}" in
    run)  SYNC_ARGS=();                   INSTALL_HOOKS=false ;;
    dev)  SYNC_ARGS=(--extra dev);        INSTALL_HOOKS=true  ;;
    test) SYNC_ARGS=(--extra test);       INSTALL_HOOKS=false ;;
    all)  SYNC_ARGS=(--all-extras);       INSTALL_HOOKS=true  ;;
esac

echo ""

# ── install ───────────────────────────────────────────────────────────────────

gum spin --spinner dot --title "Installing dependencies..." -- \
    uv sync "${SYNC_ARGS[@]}"
gum style --foreground 82 "✓ Dependencies installed"

if [ "$INSTALL_HOOKS" = true ]; then
    gum spin --spinner dot --title "Installing git hooks..." -- \
        uv run pre-commit install --install-hooks
    gum spin --spinner dot --title "Installing pre-push hook..." -- \
        uv run pre-commit install --hook-type pre-push
    gum style --foreground 82 "✓ Git hooks installed"
fi

echo ""
gum style \
    --foreground 82 --bold \
    "Done. Run scripts/run-sanity-check to verify."
echo ""
