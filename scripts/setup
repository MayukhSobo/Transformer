#!/usr/bin/env bash
set -euo pipefail

# ── usage ─────────────────────────────────────────────────────────────────────

usage() {
    printf 'Usage: %s [run|dev]\n\n' "$0"
    printf '  run   core only  (train, infer, use the model)\n'
    printf '  dev   everything (dev tools + test suite, installs git hooks)\n\n'
    printf 'Omit the argument for an interactive prompt.\n'
    exit 1
}

for arg in "$@"; do
    case "$arg" in
        -h|--help) usage ;;
        run|dev) ;;
        *) printf 'Unknown option: %s\n' "$arg" >&2; usage ;;
    esac
done

# ── ensure gum ───────────────────────────────────────────────────────────────

# shellcheck source=ensure-gum
source "$(dirname "${BASH_SOURCE[0]}")/ensure-gum"

# ── ensure uv ────────────────────────────────────────────────────────────────

# shellcheck source=ensure-uv
source "$(dirname "${BASH_SOURCE[0]}")/ensure-uv"

# ── header ────────────────────────────────────────────────────────────────────

"$GUM" style \
    --border rounded \
    --border-foreground 99 \
    --padding "1 4" \
    --margin "1 0" \
    "$("$GUM" style --foreground 99 --bold 'Transformer') — Project Setup"

# ── mode selection ────────────────────────────────────────────────────────────

if [ $# -eq 1 ]; then
    CHOICE="$1"
else
    CHOICE=$("$GUM" choose \
        --header "Select setup mode:" \
        --header.foreground 245 \
        --cursor.foreground 99 \
        --item.foreground 255 \
        --selected.foreground 99 \
        --selected.bold \
        "run   — core only  (train, infer, use the model)" \
        "dev   — everything (dev tools + test suite, installs git hooks)")
fi

# ── resolve args ──────────────────────────────────────────────────────────────

case "${CHOICE%% *}" in
    run) SYNC_ARGS=();              INSTALL_HOOKS=false ;;
    dev) SYNC_ARGS=(--all-extras);  INSTALL_HOOKS=true  ;;
esac

echo ""

# ── install ───────────────────────────────────────────────────────────────────

"$UV" sync "${SYNC_ARGS[@]}"
"$GUM" style --foreground 82 "✓ Dependencies installed"

if [ "$INSTALL_HOOKS" = true ]; then
    "$UV" tool run pre-commit install --install-hooks
    "$UV" tool run pre-commit install --hook-type pre-push
    "$GUM" style --foreground 82 "✓ Git hooks installed"
fi

echo ""
"$GUM" style \
    --foreground 82 --bold \
    "Done. Run scripts/run-sanity-check to verify."
echo ""
